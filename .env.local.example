# ─── Firebase (client SDK) ───────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ─── Meta CAPI / OAuth ────────────────────────────────────────────────────────
# App criado em developers.facebook.com com o produto "Facebook Login"
NEXT_PUBLIC_META_APP_ID=
META_APP_SECRET=

# ─── Firebase Admin (service account) ───────────────────────────────────────
# JSON completo da service account (Firebase Console → Configurações do
# projeto → Contas de serviço → Gerar nova chave privada), em uma única
# linha (string JSON). Usado só nas rotas server (lib/firebase-admin.ts).
FIREBASE_SERVICE_ACCOUNT_KEY=

# ─── Agente IA (Gemini) ──────────────────────────────────────────────────────
# Key criada em aistudio.google.com/apikey. Usada só na rota server
# /api/agent (nunca exposta ao client).
GEMINI_API_KEY=

# ─── Meta Ads — token compartilhado da BM (métricas) ────────────────────────
# System User token gerado na Business Manager que já tem acesso à maioria
# das contas de anúncio dos clientes. Usado como fallback quando o cliente
# não tem um Access Token próprio salvo na conexão "Meta Ads (Métricas)" —
# aí só o ID da conta de anúncios (act_...) já basta. Nunca prefixar com
# NEXT_PUBLIC_: é lido só em rotas server, nunca enviado ao browser.
META_BM_SYSTEM_USER_TOKEN=
# App usado só pra gerar o token acima (não é usado em código; referência).
META_BM_APP_ID=
META_BM_APP_SECRET=

# ─── Google Ads — credenciais compartilhadas da MCC (métricas) ──────────────
# Mesma ideia do Meta acima, mas pra MCC do Google Ads: cobre a maioria dos
# clientes, então o card "Google Ads (Métricas)" na aba Conexões só pede o
# Customer ID de cada cliente. Nunca prefixar com NEXT_PUBLIC_.
GADS_MCC_ID=
GADS_DEVELOPER_TOKEN=
GADS_OAUTH_CLIENT_ID=
GADS_OAUTH_CLIENT_SECRET=
GADS_REFRESH_TOKEN=

# ─── Cron (reenvio de conversões) ───────────────────────────────────────────
# Gerado automaticamente pela Vercel ao criar o cron job (Project Settings →
# Cron Jobs) — protege /api/cron/reenviar-conversoes contra chamadas externas.
CRON_SECRET=

# ─── Firebase Emulator (dev local) ──────────────────────────────────────────
# true = lib/firebase.ts conecta nos emuladores locais (firebase emulators:start)
# em vez do projeto real. Nunca setar isso no ambiente da Vercel.
NEXT_PUBLIC_USE_EMULATOR=
